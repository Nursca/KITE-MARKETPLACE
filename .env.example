# ─────────────────────────────────────────────────────────────
# Kite Marketplace — Environment Variables
# Copy this to .env.local for local dev, set as Vercel env vars for prod
# ─────────────────────────────────────────────────────────────

# App URL (used for x402 paywall callbacks and skill.json)
NEXT_PUBLIC_APP_URL=http://localhost:3000
KITE_MARKETPLACE_URL=http://localhost:3000

# ── OpenAI (powers KIMA chat agent) ──────────────────────────
OPENAI_API_KEY=sk-...

# ── Coinbase CDP Wallet (autonomous agent purchases) ─────────
# Get from: https://portal.cdp.coinbase.com
# Leave empty to run in "demo mode" (no actual on-chain purchases)
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
# Persisted wallet data (auto-generated on first run — copy from server logs)
CDP_WALLET_DATA=

# ── Kite Testnet ─────────────────────────────────────────────
NEXT_PUBLIC_KITE_RPC=https://rpc-testnet.gokite.ai
WALLET_PRIVATE_KEY=   # EVM private key for ERC-8004 identity tx (testnet only)

# ── x402 Payment Config ───────────────────────────────────────
# Address that receives USDC payments from x402 purchases
PAYMENT_RECIPIENT_ADDRESS=0xxx
X402_FACILITATOR_URL=https://x402.org/api/v1/facilitator

# ── WalletConnect (browser wallet connection) ─────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── Shopify Integration ──────────────────────────────────────────
SHOPIFY_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_app_client_secret