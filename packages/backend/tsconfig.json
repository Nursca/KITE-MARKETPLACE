{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@kite/x402-sdk": ["../kite-x402-sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../kite-x402-sdk/src/**/*"],
  "exclude": ["node_modules"]
}
